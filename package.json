{
    "name": "fv-common",
    "version": "2.1.1",
    "description": "Common helper functions",
    "license": "SEE LICENSE IN licence.md",
    "repository": "https://github.com/felixvictor/fv-common.git",
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.mts",
            "import": "./dist/node.mjs"
        },
        "./na": {
            "types": "./dist/na.d.ts",
            "import": "./dist/na.js"
        },
        "./trading": {
            "types": "./dist/trading.d.ts",
            "import": "./dist/trading.js"
        }
    },
    "scripts": {
        ".build:1:lint": "pnpm run lint",
        ".build:2:barrel": "pnpm run barrel",
        ".build:3:gen": "tsdown",
        ".build:4:commit": "git add dist/ src/ && git diff --staged --quiet || git commit -m 'build: dist'",
        ".deploy:1:build": "pnpm run build",
        ".deploy:2:release": "changelogen --clean --release --no-github --push",
        ".oxc:1:lint": "oxlint --fix",
        ".oxc:2:fmt": "pnpm run pretty-print",
        "barrel": "tsx scripts/generate-barrel.ts",
        "build": "pnpm run --sequential /^\\.build:.*/",
        "deploy": "pnpm run --sequential /^\\.deploy:.*/",
        "dev": "tsc --watch",
        "git:chore": "git add package.json pnpm-lock.yaml pnpm-workspace.yaml && git commit -m 'chore(deps): bump'",
        "helper:clean:src:js": "find ./src -name \"*.js\" -type f -delete -print",
        "lint": "pnpm run --sequential /^\\.oxc:.*/",
        "pnpm:dedupe": "pnpm dedupe",
        "pnpm:renew": "pnpm clean --lockfile && pnpm install",
        "pnpm:update": "pnpm self-update && pnpm update --interactive",
        "pretty-print": "oxfmt",
        "print-perfectionist-config": "node -e \"import('eslint-plugin-perfectionist').then(m => console.log(JSON.stringify(Object.fromEntries(Object.keys(m.default.configs['recommended-natural'].rules).sort().map(r => [r, ['error', { type: 'natural' }]])), null, 4)))\"",
        "test": "vitest run"
    },
    "dependencies": {
        "atomically": "^2.1.1",
        "colorjs.io": "^0.7.1",
        "dayjs": "^1.11.21",
        "svg-path-commander": "^2.3.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@commitlint/types": "^21.2.0",
        "@types/node": "^26.2.0",
        "changelogen": "^0.6.2",
        "eslint-plugin-perfectionist": "^5.10.1",
        "husky": "^9.1.7",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "ts-morph": "^28.0.0",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">= 26",
        "pnpm": ">= 11"
    }
}
