{
    "name": "fv-common",
    "version": "5.0.0",
    "description": "Common helper functions",
    "license": "SEE LICENSE IN licence.md",
    "repository": "https://github.com/felixvictor/fv-common.git",
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./na": "./dist/na.js",
        "./node": "./dist/node.js",
        "./trading": "./dist/trading.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        ".build:1:barrel": "pnpm run barrel",
        ".build:2:lint": "pnpm run lint",
        ".build:3:gen": "tsdown",
        ".build:4:commit": "git add dist/ src/ package.json && git diff --staged --quiet || git commit -m 'build: dist'",
        ".deploy:1:build": "pnpm run build",
        ".deploy:2:release": "changelogen --clean --release --no-github --push",
        ".oxc:1:lint": "oxlint --fix",
        ".oxc:2:fmt": "pnpm run pretty-print",
        "barrel": "node scripts/barrels.ts",
        "build": "pnpm run --sequential /^\\.build:.*/",
        "deploy": "pnpm run --sequential /^\\.deploy:.*/",
        "dev": "tsc --watch",
        "git:chore": "git add package.json pnpm-lock.yaml pnpm-workspace.yaml && git commit -m 'chore(deps): bump'",
        "helper:clean:src:js": "find ./src -name \"*.js\" -type f -delete -print",
        "lint": "pnpm run --sequential /^\\.oxc:.*/",
        "pnpm:dedupe": "pnpm dedupe",
        "pnpm:renew": "pnpm clean --lockfile && pnpm install",
        "pnpm:update": "pnpm self-update && pnpm update --interactive --latest",
        "pretty-print": "oxfmt",
        "print-perfectionist-config": "node -e \"import('eslint-plugin-perfectionist').then(m => console.log(JSON.stringify(Object.fromEntries(Object.keys(m.default.configs['recommended-natural'].rules).sort().map(r => [r, ['error', { type: 'natural' }]])), null, 4)))\"",
        "test": "vitest run"
    },
    "dependencies": {
        "atomically": "^2.1.1",
        "colorjs.io": "^0.7.1",
        "svg-path-commander": "^2.3.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@commitlint/types": "^21.2.3",
        "@types/node": "^26.6.4",
        "changelogen": "^0.6.2",
        "eslint-plugin-perfectionist": "^5.12.1",
        "husky": "^9.1.7",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">= 26",
        "pnpm": ">= 12"
    }
}
