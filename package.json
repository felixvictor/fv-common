{
    "name": "fv-common",
    "version": "1.68.2",
    "description": "Common helper functions",
    "license": "SEE LICENSE IN licence.md",
    "repository": "https://github.com/felixvictor/fv-common.git",
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.mts",
            "import": "./dist/node.mjs"
        },
        "./na": {
            "types": "./dist/na.d.ts",
            "import": "./dist/na.js"
        },
        "./trading": {
            "types": "./dist/trading.d.ts",
            "import": "./dist/trading.js"
        }
    },
    "scripts": {
        ".oxc:1:lint": "oxlint --fix",
        ".oxc:2:fmt": "oxfmt",
        "barrel": "tsx scripts/generate-barrel.ts",
        "build": "run-s lint barrel build:gen build:commit",
        "build:commit": "git add dist/ src/ && git diff --staged --quiet || git commit -m 'build: dist'",
        "build:gen": "tsdown",
        "build:push": "git push",
        "dev": "tsc --watch",
        "git:chore": "git add package.json pnpm-lock.yaml pnpm-workspace.yaml && git commit -m 'chore(deps): bump'",
        "helper:clean:src:js": "find ./src -name \"*.js\" -type f -delete -print",
        "lint": "pnpm run --sequential /^\\.oxc:.*/",
        "main:release": "run-s build release build:push",
        "pnpm:dedupe": "pnpm dedupe",
        "pnpm:renew": "pnpm clean --lockfile && pnpm install",
        "pnpm:update": "pnpm self-update && pnpm update --interactive",
        "pretty-print": "pnpm run .oxc:fmt",
        "print-perfectionist-config": "node -e \"import('eslint-plugin-perfectionist').then(m => console.log(JSON.stringify(Object.fromEntries(Object.keys(m.default.configs['recommended-natural'].rules).sort().map(r => [r, ['error', { type: 'natural' }]])), null, 4)))\"",
        "push": "git push",
        "release": "release-it --ci",
        "test": "vitest run"
    },
    "dependencies": {
        "atomically": "^2.1.1",
        "colorjs.io": "^0.7.1",
        "dayjs": "^1.11.21",
        "svg-path-commander": "^2.3.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@commitlint/types": "^21.2.0",
        "@release-it/conventional-changelog": "^12.0.0",
        "@types/node": "^26.1.2",
        "eslint-plugin-perfectionist": "^5.10.1",
        "husky": "^9.1.7",
        "npm-run-all2": "^9.0.3",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "release-it": "^21.0.1",
        "ts-morph": "^28.0.0",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.9",
        "typescript": "6.0.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">= 26",
        "pnpm": ">= 11"
    },
    "release-it": {
        "git": {
            "commitMessage": "chore: release v${version}",
            "push": false
        },
        "github": {
            "release": false
        },
        "gitlab": {
            "release": false
        },
        "npm": {
            "publish": false
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "infile": "CHANGELOG.md",
                "preset": "conventionalcommits"
            }
        }
    }
}
